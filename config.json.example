{
  "telegram_bot_token": "YOUR_BOT_TOKEN_HERE",
  "telegram_chat_id": "YOUR_CHAT_ID_HERE",
  "watchers": [
    {
      "name": "Example Product (HTML)",
      "type": "html",
      "url": "https://example.com/product",
      "threshold": 115.0,
      "config": {
        "selector": "p.oopStage-priceRangeCtaRange",
        "price_index": 0,
        "timeout": 30,
        "retries": 3
      }
    },
    {
      "name": "Example Product (Playwright)",
      "type": "playwright",
      "url": "https://example.com/product",
      "threshold": 115.0,
      "config": {
        "selector": "div.mt-auto div.text-orange-500",
        "price_index": 0,
        "wait_time": 5000,
        "timeout": 30000,
        "headless": true
      }
    }
  ]
}

